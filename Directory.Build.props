<Project>
  <!-- Shared settings for every project in the solution. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Greenfield: all code is new, so every warning is an error from day one.
         EF migrations are marked <auto-generated/> and are therefore not analysed. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!-- Pin the analyser rule set to .NET 9 so a newer SDK on a developer machine reports the same
         warnings as the .NET 9 SDK in CI and in the Docker build. -->
    <AnalysisLevel>9.0</AnalysisLevel>

    <!-- NuGet vulnerability audit on direct and transitive packages. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- AutoMapper 14.x CVE-2026-32933 (stack overflow when mapping a deeply self-referencing graph).
         No 14.x patch exists; the patched majors are commercial. Suppressed for this one advisory only,
         because we never map request input and no mapped type references itself (guarded by the
         architecture test CONV_15_Mapped_types_are_not_self_referencing). Decision: D-37. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>
</Project>
