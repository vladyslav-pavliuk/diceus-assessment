{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/*.{js,css,ico,png,svg,jpg,jpeg,gif,webp,woff,woff2,ttf,map,json,txt}"]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": { "Cache-Control": "no-cache" }
    }
  ],
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
